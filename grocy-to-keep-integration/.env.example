# Copy to .env and fill in. Do NOT commit .env.

# --- Grocy -----------------------------------------------------------------
GROCY_URL=https://grocy.example.com
GROCY_API_KEY=

# --- Home Assistant --------------------------------------------------------
# Use the LAN IP, not a hostname. mDNS does not cross into the container, so
# `homeassistant.local` resolves on your laptop and fails inside the worker —
# the deploy agent's smoke test is where you would find out.
HA_URL=http://192.168.1.10:8123
# Profile -> Security -> Long-lived access tokens. Make a dedicated one for
# this worker so it can be revoked without affecting anything else.
HA_TOKEN=

# --- Target lists ----------------------------------------------------------
# Both exist as local_todo entries. AUTO_LIST is SHARED with the household:
# they add their own rows to it, and the worker only ever touches rows in its
# own format ("Navn — 1/2 Pakke"). Everything else on it is left alone.
AUTO_LIST=todo.indkob
SUGGEST_LIST=todo.grocy_forslag

# --- analyse tuning --------------------------------------------------------
# One year of history. At 90d only 5 products cleared MIN_EVENTS; at 365d it
# is 25, which is what makes the suggestions worth reading.
LOOKBACK_DAYS=365
SHOPPING_INTERVAL_DAYS=7
SAFETY_K=1.0
MIN_EVENTS=4
CHANGE_THRESHOLD=0.25
SPOILAGE_FLAG=0.15

# --- shelf-life / expiry analysis ------------------------------------------
# Shelf life is observed per product from consume rows
# (best_before_date - purchased_date); default_best_before_days is set on only
# 5 of 109 products so it cannot be relied on. Grocy stores sentinel year-9999
# best-before dates for non-perishables, which appear as ~355000-day shelf
# lives — anything above this cap is treated as "does not meaningfully expire".
SHELF_SANE_MAX_DAYS=3650
# Need at least this many observations before trusting a median shelf life.
MIN_SHELF_OBS=2
# If more than this fraction of units were consumed AFTER their best-before
# date, the product is flagged and its suggested minimum is capped at what can
# actually be eaten within one shelf life.
LATE_USE_FLAG=0.34

# --- automatic default_best_before_days -------------------------------------
# Writes observed shelf life back to Grocy so that scanning a barcode at
# purchase pre-fills a sensible best-before date. This is the ONE thing the
# worker changes in Grocy without approval — the reasoning is that the date on
# the physical package is checked anyway, so a wrong default costs a
# correction, not a spoiled product. Set to 0 to turn it off.
SET_DEFAULT_EXPIRY=1
# Observations required before writing. Higher than MIN_SHELF_OBS above: that
# gates a number you eyeball on a list, this gates one that silently pre-fills
# every future purchase.
MIN_SHELF_OBS_WRITE=4
# Reject products whose observations disagree (median absolute deviation over
# the median). A product seen at 3, 5, 300 and 400 days has no single default.
SHELF_REL_SPREAD=0.4
# Leave an existing value alone unless observation disagrees by more than this.
# Some defaults were set by hand and are near enough already.
EXPIRY_CHANGE_THRESHOLD=0.3

# --- barcode prices ---------------------------------------------------------
# Fills product_barcodes.last_price where it is EMPTY, so scanning a barcode at
# purchase pre-fills a price. Never overwrites a price that is already there.
# Both sources are keyed on exact identifiers — there is no name matching, so a
# price cannot be attached to the wrong product. Set to 0 to turn it off.
SET_BARCODE_PRICES=1
# How far back to look for a price you typed yourself. Long on purpose: an old
# price beats no price when it is only ever a pre-fill.
PRICE_LOOKBACK_DAYS=1825

# Optional second source: Salling's Products EAN API (Netto/Føtex/Bilka),
# GET /v2/products/{ean} — barcode in, shelf price out. Exact match, so it
# cannot attach a price to the wrong product.
#
# Free token: developer.sallinggroup.dev -> sign in -> create a token with the
# "Products EAN" scope. Leave blank and this half is skipped; the
# purchase-history backfill still runs.
#
# Salling offers this API for educational, non-commercial use, and access must
# be REQUESTED in the portal — signing up does not grant it.
SALLING_TOKEN=
# Prices are per physical store, and the store decides both the price and
# whether the product is stocked at all. Comma-separated UUIDs are rotated by
# ISO week number, so two ids alternate odd and even weeks — which also widens
# coverage, since a barcode the small Netto does not carry may be found at the
# Bilka a fortnight later. Only empty prices are ever filled, so the two
# ranges accumulate rather than fight.
#
# Blank means the Salling half is skipped. Find ids with the Stores API
# (separate scope, same portal):
#   curl -s "https://api.sallinggroup.com/v2/stores?zip=4632&brand=netto" \
#     -H "Authorization: Bearer $SALLING_TOKEN"
# There is no Bilka in every zip; search by coordinates with
# ?geo=<lat>,<lon>&brand=bilka&radius=100 to find the nearest.
#
# Netto Bjæverskov (4632) and Bilka Waves, Hundige (2670, 24 km):
SALLING_STORE_ID=8093199f-aff0-46a1-8c93-324c396ab124,c6744248-cf95-43c3-aa43-d3daef2aeb4b
# One request per barcode, and the quota is 100 PER DAY. 90 leaves room for a
# manual run on the same day. With ~128 unpriced barcodes the first pass takes
# two weekly runs; after that only the misses are re-asked.
SALLING_MAX_LOOKUPS=90
# Seconds between lookups. There is a burst limit ON TOP OF the daily quota:
# a dozen back-to-back requests get 429s however much allowance is left.
SALLING_DELAY=1.5
